---
import ProductCard from '../components/ProductCard';

// Definice produktů
const products = [
  {
    name: "Exodus CD",
    price: 349,
    image: "/images/exodus1.webp",
    description: "Následující album Exodus přichází s novým zvukem.",
    priceId: "price_1QSqJ3ECICPYvq5cHthU9nQK"
  },
  {
    name: "Leopard CD",
    price: 299,
    image: "/images/leopard1.png",
    description: "Debutové album Leopard v digitální kvalitě na CD.",
    priceId: "price_1QSqJ3ECICPYvq5cFS1dtBzq"
  },
  {
    name: "MDMX - Leopoldstadt",
    price: 499,
    image: "/images/leopoldstadt1.jpg",
    description: "Debutové album Leopoldstadt v analogové kvalitě na kazetě.",
    priceId: "price_1QSqHZECICPYvq5c84nAjsBM"
  }
];
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Produkty | Yeezuz2020 obchod</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-black font-sans">
  <header class="py-8 text-center border-b border-gray-200">
    <h1 class="text-4xl font-bold">Yeezuz2020 Merchandise</h1>
    <a href="/" class="text-lg text-black border border-black rounded-full py-2 px-4 mt-4 inline-block hover:bg-black hover:text-white transition-colors">Zpět na hlavní stránku</a>
  </header>

  <main class="max-w-7xl mx-auto my-8 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <ProductCard
          name={product.name}
          price={product.price}
          image={product.image}
          description={product.description}
          priceId={product.priceId}
        />
      ))}
    </div>
  </main>
</body>
</html>
